# Connection string de Neon (Console -> Project -> Connection string, pooled)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Token compartido con la app Flutter. Generar con: openssl rand -hex 32
# La app se compila con --dart-define=CINGULA_SYNC_API_KEY=<mismo valor>
SYNC_API_KEY=
# Clave de la web de gestión: SOLO LECTURA (pull/state; el push la rechaza con 403).
# Valor distinto de SYNC_API_KEY. Vacía o ausente = esa clave no da acceso.
WEB_API_KEY=
